# Configuração da Aplicação
APP_ENV=production
DOMAIN=app.fortexagourmet.com.br

# Configuração do Banco de Dados (PostgreSQL)
DB_DATABASE=fortexa_db
DB_USERNAME=fortexa_user
DB_PASSWORD=senha_super_segura_aqui

# Segurança (Gere uma string aleatória longa)
# Exemplo via terminal: openssl rand -base64 32
SESSION_SECRET=sua_chave_secreta_de_sessao_aqui

APP_KEY=sua_chave_de_32_bytes_em_hex_aqui
